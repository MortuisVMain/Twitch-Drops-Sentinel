<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <WebView2LoaderPreference>Static</WebView2LoaderPreference>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <StartupObject>TwitchDropsSentinel.Program</StartupObject>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>TwitchDropsSentinel</AssemblyName>
    <AssemblyTitle>Twitch Drops Sentinel</AssemblyTitle>
    <Product>Twitch Drops Sentinel</Product>
    <Description>Twitch Drops Sentinel by Mortuis_V_Studio</Description>
    <Version>3.3.0</Version>
    <Authors>Mortuis_V_Studio</Authors>
    <Company>Mortuis_V_Studio</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\dist\index.html" Link="Resources\index.html" />
  </ItemGroup>

</Project>


